# Copia este archivo a .env y ajusta los valores. .env NO se sube a git.

# Clave maestra. De ella salen (1) la firma de las sesiones, (2) el cifrado de las llaves privadas
# de las universidades y (3) el secreto que vuelve irreversible el ID de alumno.
# CÁMBIALA ANTES de crear tu base de datos real y NO la pierdas: sin ella no se pueden descifrar
# las llaves de las universidades ni reasociar matrículas. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL (recomendado). Si lo dejas vacío se usa un archivo SQLite local (tituloseguro.db).
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/tituloseguro

# production = cookies seguras, sin cuentas demo, SECRET_KEY obligatoria.
# TS_ENV=production

# Con TS_ENV=production no se crean cuentas demo: define la contraseña del administrador inicial.
# ADMIN_PASSWORD=
# SEED_DEMO=1   # fuerza cuentas demo + 1,000 credenciales de prueba (por defecto: sí en desarrollo, no en producción)
